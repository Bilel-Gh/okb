#!/bin/sh
# Claude Code puts a plugin's bin/ on the Bash tool's PATH while the plugin is
# enabled. This wrapper runs the CLI shipped beside the plugin (npm package or
# built source checkout), so skills and CLI always come from the same version.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# Commands run for Claude never ask questions (an agent cannot answer for the
# person), and say which plugin version called them so a mismatch is reported.
export OKB_NO_INTERACTIVE=1
# Commands Claude runs: a note it prepares needs the person's accepted suggestion (src/suggest/guard.ts).
export OKB_VIA_CLAUDE=1
OKB_PLUGIN_VERSION=$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$here/../.claude-plugin/plugin.json" 2>/dev/null | head -1)
export OKB_PLUGIN_VERSION
cli="$here/../../dist/cli/index.js"
if [ -f "$cli" ]; then
  exec node "$cli" "$@"
fi
# Plugin copied without its package (e.g. a marketplace cache): use the launcher
# that points to the user's checkout or install, then another okb on PATH.
for launcher in "${OKB_CLI:-}" "${OKB_HOME:-$HOME/.okb}/bin/okb"; do
  [ -n "$launcher" ] && [ -x "$launcher" ] && exec "$launcher" "$@"
done
old_ifs=$IFS
IFS=:
for dir in $PATH; do
  [ -n "$dir" ] && [ -x "$dir/okb" ] || continue
  [ "$(CDPATH= cd -- "$dir" 2>/dev/null && pwd)" = "$here" ] && continue
  IFS=$old_ifs
  exec "$dir/okb" "$@"
done
IFS=$old_ifs
echo "okb: the OKB engine is not installed on this machine yet. Install it with: sh \"$here/../scripts/engine.sh\" (Claude does it when you say « configure OKB »)." >&2
exit 127
