{
  "name": "okb",
  "version": "2.0.0",
  "description": "Open Knowledge Brain \u2014 a local, profile-driven second brain that ingests sources and proposes reviewed, traceable changes to an OKF knowledge bundle.",
  "license": "MIT",
  "type": "module",
  "main": "dist/desktop/main.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "okb": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "plugin",
    "plugins",
    "templates",
    "web",
    "docs",
    "!docs/images",
    "README.md",
    "LICENSE",
    "DEMARRER.md",
    "examples",
    ".claude-plugin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config web-app/vite.config.ts --logLevel warn",
    "clean": "node scripts/clean.mjs",
    "test": "npm run build && vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web-app/tsconfig.json",
    "prepack": "npm run clean && npm run build",
    "check": "npm run typecheck && npm test",
    "validate:plugin": "node scripts/validate-plugin.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "release:check": "npm run check && npm run validate:plugin && npm run smoke:package",
    "bench:speed": "npm run build && node scripts/perf.mjs",
    "dev:web": "vite --config web-app/vite.config.ts",
    "test:journeys": "npm run build && vitest run --config vitest.journeys.config.ts",
    "desktop:dev": "npm run build && node node_modules/electron/install.js && electron .",
    "desktop:dir": "npm run build && node scripts/desktop-build.mjs --dir",
    "desktop:build": "npm run build && node scripts/desktop-build.mjs",
    "desktop:release": "node scripts/desktop-release.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "d3-force": "^3.0.0",
    "electron-updater": "6.8.9",
    "mammoth": "^1.8.0",
    "mermaid": "^12.1.0",
    "minisearch": "^7.2.0",
    "node-html-parser": "^6.1.13",
    "picocolors": "^1.1.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "ts-fsrs": "^5.4.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "unpdf": "1.8.1",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-hover-card": "^1.1.24",
    "@radix-ui/react-popover": "^1.2.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-virtual": "^3.14.13",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cmdk": "^1.1.1",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "happy-dom": "^20.14.5",
    "lucide-react": "^1.52.0",
    "playwright-core": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.7.2",
    "vite": "^8.3.3",
    "vitest": "4.1.11"
  }
}
