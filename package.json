{
  "name": "okb",
  "version": "0.3.0",
  "description": "Open Knowledge Brain \u2014 a local, profile-driven second brain that ingests sources and proposes reviewed, traceable changes to an OKF knowledge bundle.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "okb": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "plugin",
    "docs",
    "README.md",
    "LICENSE",
    "DEMARRER.md",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "npm run build && vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run clean && npm run build",
    "check": "npm run typecheck && npm test",
    "validate:plugin": "node scripts/validate-plugin.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "release:check": "npm run check && npm run validate:plugin && npm run smoke:package"
  },
  "dependencies": {
    "mammoth": "^1.8.0",
    "node-html-parser": "^6.1.13",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "unpdf": "1.8.1",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "4.1.11"
  }
}
