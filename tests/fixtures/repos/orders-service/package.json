{
  "name": "@acme/orders-service",
  "version": "1.4.2",
  "description": "Order management for the Acme web shop (SAP CAP).",
  "engines": { "node": ">=20" },
  "dependencies": {
    "@sap/cds": "^8.3.0",
    "@sap/xssec": "^4.2.0",
    "@sap-cloud-sdk/http-client": "^3.20.0",
    "@cap-js/hana": "^1.3.0",
    "@acme/pricing-rules": "^2.1.0",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^1.7.0",
    "@sap/cds-dk": "^8.3.0",
    "jest": "^29.7.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "test": "jest",
    "lint": "eslint srv",
    "build": "mbt build -t mta_archives",
    "deploy": "cf deploy mta_archives/orders-service_1.4.2.mtar"
  },
  "cds": {
    "requires": {
      "db": { "kind": "sql" },
      "auth": { "kind": "xsuaa" },
      "API_BUSINESS_PARTNER": {
        "kind": "odata-v2",
        "model": "srv/external/API_BUSINESS_PARTNER",
        "credentials": { "destination": "S4_BP", "path": "/sap/opu/odata/sap/API_BUSINESS_PARTNER" }
      },
      "messaging": { "kind": "enterprise-messaging" }
    }
  }
}
